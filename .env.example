# Copy to .env and fill in. .env is gitignored — never commit real values.

# Lambda Cloud API key (cloud.lambda.ai -> API keys)
LAMBDA_API_KEY=

# Local API token: when set, every backend request must send
# `Authorization: Bearer <this>`. Leave empty and the backend GENERATES
# one on its first real-mode start (and writes it here); empty stays
# open only in mock mode. Clients read it from this file - the dashboard
# asks for a paste, MCP configs carry it as MANIFOLD_API_TOKEN.
MANIFOLD_API_TOKEN=

# Filesystem S3 Adapter credentials (cloud.lambda.ai -> S3 Adapter Keys)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: Tailscale auth key. If absent, "tailscale" connection mode is
# unavailable and launches requesting it are rejected with a clear error.
TAILSCALE_AUTHKEY=

# Optional: bearer token for the OpenAI-compatible /v1 proxy. If set, every
# /v1 request must send `Authorization: Bearer <this>`. Empty = open, which
# is fine for localhost-only single-user use.
MANIFOLD_PROXY_KEY=

# Optional: HuggingFace token (hf.co -> Settings -> Access Tokens). Lets the
# model-fit preflight read exact sizes for gated repos whose license you
# have accepted. Read-only scope is enough.
HF_TOKEN=

# Optional: Google Cloud provider (Settings page writes these). Names
# only; leave empty unless you use the GCP provider.
GCP_PROJECT_ID=
GCP_DEFAULT_ZONE=
GOOGLE_APPLICATION_CREDENTIALS=
