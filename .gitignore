# Secrets — never commit
.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# SQLite databases (local state, not source)
*.db
*.db-wal
*.db-shm

# SSH host-key pins (local state, machine-specific)
host_keys.json

# Node / Next.js (Phase 2+)
node_modules/
.next/

# OS noise
.DS_Store

# desktop packaging
*.dmg
*.msi
dashboard/out/
backend/dist/
backend/build/
backend/*.spec
desktop/node_modules/
desktop/src-tauri/target/
desktop/src-tauri/binaries/
desktop/src-tauri/gen/
desktop/src-tauri/icons/android/
desktop/src-tauri/icons/ios/
custom-templates/
worklog.md
manifold-worklog.md

# Phase 85: the local model library. In development DATA_ROOT is the repo
# root, so pulled .gguf models land here - multi-gigabyte files that must
# never be committable. The packaged app puts them in the platform app-data
# dir instead.
/models/

# CLI-brain scratch dir: a frontier CLI runs with cwd set here, and in
# development DATA_ROOT is the repo root, so anything it drops would
# otherwise show up as untracked churn in the user's clone.
/hub-scratch/
